{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grominet95.github.io/jarvis-skills/schemas/preset.schema.json",
  "title": "Jarvis Preset",
  "description": "Schéma de validation d'un skill.yaml de type preset",
  "type": "object",
  "required": [
    "name",
    "version",
    "author",
    "description",
    "tags",
    "type",
    "triggers",
    "platforms",
    "requires_env",
    "requires_tools",
    "requires_oauth",
    "requires_apps",
    "capabilities",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/schema_version"
    },
    "name": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/kebab_id",
      "description": "Identifiant unique kebab-case (lettres minuscules, chiffres, tirets)"
    },
    "version": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/semver"
    },
    "author": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/author"
    },
    "description": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/description_field"
    },
    "tags": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/tags",
      "description": "Mots-clés — \"preset\" doit être le premier élément"
    },
    "permissions": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/permissions"
    },
    "type": {
      "const": "preset",
      "description": "Type du skill — doit être exactement \"preset\""
    },
    "jarvis_min_version": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Version minimale de Jarvis requise (ex: 3.0)"
    },
    "triggers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "Phrases déclencheuses en langage naturel (ex: \"lance le mode travail\")"
    },
    "platforms": {
      "type": "array",
      "items": { "enum": ["mac", "windows", "linux"] },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Plateformes supportées — ne lister que les plateformes testées"
    },
    "requires_env": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/requires_env"
    },
    "requires_tools": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Outils Jarvis requis (ex: execute_cli, spotify_control)"
    },
    "requires_oauth": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Connexions OAuth requises"
    },
    "requires_apps": {
      "type": "array",
      "description": "Applications tierces requises",
      "items": {
        "type": "object",
        "required": ["name", "description", "url", "required"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "mac_bundle": { "type": "string", "description": "Nom dans /Applications/ (ex: \"OBS\")" },
          "windows_exe": { "type": "string", "description": "Nom du processus Windows (ex: \"obs64.exe\")" },
          "required": { "type": "boolean" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "maxItems": 6,
      "description": "Liste de ce que la preset fait — max 6, chaque item commence par un verbe"
    },
    "dry_run_possible": {
      "type": "boolean",
      "description": "true si un mode dry-run peut être activé côté jarvis-OS (obligatoire si steps CLI destructifs présents)"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Séquence d'actions exécutées dans l'ordre",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Nom descriptif du step (affiché dans les logs)"
        },
        "type": {
          "type": "string",
          "enum": ["cli", "spotify", "tts", "ai", "wait", "notify"],
          "description": "Type du step"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "cli" } }, "required": ["type"] },
          "then": {
            "description": "Step CLI : exécute une commande shell",
            "oneOf": [
              {
                "required": ["platforms"],
                "properties": {
                  "platforms": { "$ref": "#/$defs/cli_platforms" },
                  "requires_confirmation": { "type": "boolean" }
                }
              },
              {
                "required": ["command"],
                "properties": {
                  "command": { "type": "string", "minLength": 1, "description": "Commande identique sur tous les OS" },
                  "requires_confirmation": { "type": "boolean" }
                }
              }
            ]
          }
        },
        {
          "if": { "properties": { "type": { "const": "spotify" } }, "required": ["type"] },
          "then": {
            "required": ["action"],
            "properties": {
              "action": {
                "type": "string",
                "enum": ["search_playlist", "search_track", "play", "pause", "next"]
              },
              "query": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "tts" } }, "required": ["type"] },
          "then": {
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "ai" } }, "required": ["type"] },
          "then": {
            "required": ["prompt"],
            "properties": {
              "prompt": { "type": "string", "minLength": 1 },
              "output_var": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "wait" } }, "required": ["type"] },
          "then": {
            "required": ["seconds"],
            "properties": {
              "seconds": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "notify" } }, "required": ["type"] },
          "then": {
            "required": ["title", "body"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "body": { "type": "string", "minLength": 1 },
              "platforms": {
                "type": "object",
                "properties": {
                  "mac":     { "type": ["boolean", "null"] },
                  "windows": { "type": ["boolean", "null"] },
                  "linux":   { "type": ["boolean", "null"] }
                }
              }
            }
          }
        }
      ]
    },
    "cli_platforms": {
      "type": "object",
      "description": "Commandes par plateforme — null = step skippé sur cette plateforme",
      "minProperties": 1,
      "properties": {
        "mac":     { "type": ["string", "null"] },
        "windows": { "type": ["string", "null"] },
        "linux":   { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}

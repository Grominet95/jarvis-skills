{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grominet95.github.io/jarvis-skills/schemas/view.schema.json",
  "title": "Jarvis View — front-matter VIEW.md",
  "description": "Schéma de validation du front-matter YAML d'un fichier VIEW.md",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "author",
    "description",
    "glyph"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/schema_version"
    },
    "id": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/kebab_id",
      "description": "Identifiant unique kebab-case — doit correspondre exactement à l'id dans Jarvis.views.register()"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Nom affiché dans le marketplace"
    },
    "version": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/semver"
    },
    "author": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/author"
    },
    "description": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/description_field"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Mots-clés pour le filtre du marketplace"
    },
    "glyph": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,4}$",
      "description": "2-4 lettres/chiffres majuscules affichés dans le badge de la carte (ex: GLB, MAP, CAM)"
    },
    "permissions": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/permissions"
    },
    "requires_env": {
      "type": "array",
      "description": "Variables d'environnement requises",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "example": { "type": "string" },
          "sensitive": { "type": "boolean" }
        }
      }
    },
    "commands": {
      "type": "array",
      "description": "Commandes supportées par la méthode command() de la vue",
      "items": {
        "type": "object",
        "required": ["action", "description"],
        "additionalProperties": false,
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "params": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grominet95.github.io/jarvis-skills/schemas/skill.schema.json",
  "title": "Jarvis Skill conversationnel",
  "description": "Schéma de validation d'un skill.yaml de type conversational",
  "type": "object",
  "required": [
    "name",
    "version",
    "author",
    "description",
    "tags",
    "type",
    "platforms",
    "requires_env",
    "requires_tools",
    "requires_oauth",
    "requires_apps",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/schema_version"
    },
    "name": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/kebab_id",
      "description": "Identifiant unique kebab-case (lettres minuscules, chiffres, tirets)"
    },
    "version": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/semver"
    },
    "author": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/author"
    },
    "description": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/description_field"
    },
    "tags": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/tags",
      "description": "Mots-clés pour le filtre du marketplace"
    },
    "permissions": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/permissions"
    },
    "type": {
      "const": "conversational",
      "description": "Type du skill — doit être exactement \"conversational\""
    },
    "jarvis_min_version": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Version minimale de Jarvis requise (ex: 3.0)"
    },
    "triggers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Phrases déclencheuses — toujours vide [] pour les skills conversationnels"
    },
    "platforms": {
      "type": "array",
      "items": { "enum": ["mac", "windows", "linux"] },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Plateformes supportées"
    },
    "requires_env": {
      "$ref": "https://grominet95.github.io/jarvis-skills/schemas/common.schema.json#/$defs/requires_env"
    },
    "requires_tools": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Outils Jarvis requis (ex: browser, execute_cli)"
    },
    "requires_oauth": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Connexions OAuth requises (ex: google, spotify)"
    },
    "requires_apps": {
      "type": "array",
      "description": "Applications tierces requises",
      "items": {
        "type": "object",
        "required": ["name", "description", "url", "required"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "Nom affiché de l'application" },
          "description": { "type": "string", "minLength": 1, "description": "Pourquoi cette application est nécessaire" },
          "url": { "type": "string", "format": "uri", "description": "URL de téléchargement" },
          "mac_bundle": { "type": "string", "description": "Nom dans /Applications/ (ex: \"Visual Studio Code\")" },
          "windows_exe": { "type": "string", "description": "Nom du processus Windows (ex: \"code.exe\")" },
          "required": { "type": "boolean", "description": "true = bloquant, false = optionnel" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "maxItems": 6,
      "description": "Liste de ce que le skill peut faire — max 6, chaque item commence par un verbe à la 3e personne"
    }
  }
}
